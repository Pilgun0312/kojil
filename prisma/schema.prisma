generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  industry    String?
  location    String?
  country     String   @default("KR")
  description String?
  website     String?
  size        String?
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  icon String?
  jobs Job[]
}

model Job {
  id               String        @id @default(cuid())
  title            String
  description      String
  requirements     String[]
  responsibilities String[]
  benefits         String[]
  salaryMin        Int?
  salaryMax        Int?
  currency         String        @default("MNT")
  country          String        @default("KR")
  location         String
  type             String        @default("FULL_TIME")
  mode             String        @default("ONSITE")
  experience       String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  views            Int           @default(0)
  company          Company       @relation(fields: [companyId], references: [id])
  companyId        String
  category         Category      @relation(fields: [categoryId], references: [id])
  categoryId       String
  applications     Application[]
  savedBy          SavedJob[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId])
  @@index([categoryId])
}

model Application {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  expectedSalary Int?
  coverLetter    String?
  status         String   @default("PENDING")
  job            Job      @relation(fields: [jobId], references: [id])
  jobId          String
  createdAt      DateTime @default(now())

  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  sessionId String
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  createdAt DateTime @default(now())

  @@unique([sessionId, jobId])
  @@index([sessionId])
}
